.page {
  background: var(--paper-cream);
  min-height: 100vh;
  padding: 40rpx 32rpx 120rpx;
}

.head {
  text-align: center;
  margin-bottom: 32rpx;
}
.head__emoji {
  display: inline-block;
  font-size: 64rpx;
  line-height: 1;
}
.head__title {
  margin-top: 8rpx;
  font-size: 64rpx;
  line-height: 1.1;
}
.head__sub {
  margin-top: 8rpx;
}

.card {
  background: #FFFCF5;
  border-radius: 12rpx;
  padding: 32rpx;
  box-shadow: var(--shadow-polaroid);
}
.card__label {
  margin-bottom: 8rpx;
}
.card__original {
  font-size: 48rpx;
  line-height: 1.1;
  margin-bottom: 24rpx;
  color: var(--kraft-dark);
}
.card__input {
  background: var(--paper-cream);
  border: 1px solid rgba(168, 138, 92, .35);
  border-radius: 8rpx;
  padding: 16rpx 24rpx;
  font-size: 28rpx;
  line-height: 1.4;
  height: 72rpx;
  color: var(--ink-primary);
  margin-bottom: 16rpx;
}
.card__placeholder {
  color: rgba(42, 37, 32, .35);
  font-size: 28rpx;
}
.hint {
  font-size: 24rpx;
  color: var(--ink-secondary);
  margin-bottom: 16rpx;
  line-height: 1.5;
}
.hint--warn {
  color: var(--pin-red);
}
.card__submit {
  width: 100%;
  background: var(--ink-primary);
  color: var(--paper-cream);
  border-radius: 999rpx;
  font-size: 30rpx;
  padding: 30rpx 48rpx;
  margin-top: 16rpx;
  line-height: 1.4;
  letter-spacing: 2rpx;
}
.card__submit--disabled {
  background: rgba(168, 138, 92, .35);
  color: rgba(42, 37, 32, .55);
}
