<view class="viewer">
  <view wx:if="{{loading}}" class="empty">读取中…</view>

  <swiper
    wx:elif="{{photos.length > 0}}"
    class="swiper"
    current="{{current}}"
    bindchange="onChange"
    bindtouchstart="onSwiperTouchStart"
    duration="280"
    easing-function="easeInOutCubic"
    disable-touch="{{anyZoomed}}"
  >
    <swiper-item wx:for="{{photos}}" wx:key="id" wx:for-index="i">
      <view class="frame">
        <movable-area class="ma" scale-area="{{true}}">
          <movable-view
            class="mv"
            direction="all"
            scale="{{true}}"
            scale-min="1"
            scale-max="3"
            scale-value="{{scales[i]}}"
            out-of-bounds="{{false}}"
            inertia="{{true}}"
            data-index="{{i}}"
            bindscale="onScale"
            bindlongpress="onLongPress"
          >
            <image
              class="mv__img"
              src="{{item.thumbnailUrl}}"
              mode="aspectFit"
              lazy-load="true"
            />
          </movable-view>
        </movable-area>
      </view>
    </swiper-item>
  </swiper>

  <!-- Top-right favorite heart -->
  <view
    wx:if="{{currentFav}}"
    class="heart {{currentFav.favoritedByMe ? 'heart--on' : ''}}"
    bindtap="onFavoriteTap"
  >
    <text class="heart__glyph">{{currentFav.favoritedByMe ? '♥' : '♡'}}</text>
    <text wx:if="{{currentFav.favoriteCount > 0}}" class="heart__count">{{currentFav.favoriteCount}}</text>
  </view>

  <!-- Prev / Next chevron buttons. Hidden while pinch-zoomed because the
       gesture conflicts with the swiper, and at the array edges. -->
  <view
    wx:if="{{!anyZoomed && current > 0}}"
    class="nav nav--prev"
    catchtap="onPrev"
  >
    <text class="nav__chev">‹</text>
  </view>
  <view
    wx:if="{{!anyZoomed && current < photos.length - 1}}"
    class="nav nav--next"
    catchtap="onNext"
  >
    <text class="nav__chev">›</text>
  </view>

  <!-- Bottom status bar: counter + tags + edit info button.
       Sits above safe-area inset so it's reachable on iPhones with home bar. -->
  <view wx:if="{{photos.length > 0}}" class="bottom safe-area-inset-bottom">
    <view class="bottom__counter">{{current + 1}} / {{photos.length}}</view>
    <scroll-view
      wx:if="{{currentTags.length > 0}}"
      class="bottom__tags"
      scroll-x="true"
      enhanced="{{true}}"
      show-scrollbar="{{false}}"
    >
      <view wx:for="{{currentTags}}" wx:key="*this" class="bottom__tag">#{{item}}</view>
    </scroll-view>
    <view class="bottom__edit" bindtap="onInfoToggle">
      <text class="bottom__edit-emoji">✏️</text>
      <text class="bottom__edit-label">编辑信息</text>
    </view>
  </view>

  <!-- Info drawer (unchanged structurally, just polished by the WXSS) -->
  <view wx:if="{{infoOpen}}" class="info-mask" bindtap="onInfoToggle">
    <view class="info-drawer" catchtap="onInfoNoop">
      <view class="info__handle"></view>
      <view class="info__title">照片信息</view>
      <label class="info__field">
        <text class="info__label">描述</text>
        <textarea
          class="info__textarea"
          value="{{draftCaption}}"
          placeholder="写点关于这张照片的说明…"
          maxlength="2000"
          bindinput="onCaptionInput"
        />
      </label>
      <view class="info__row">
        <text class="info__label">拍摄于</text>
        <text class="info__value">{{currentTakenAtLabel || '—'}}</text>
      </view>
      <view class="info__field">
        <text class="info__label">标签</text>
        <tag-picker
          value="{{draftTags}}"
          suggest="{{tagSuggestions}}"
          placeholder="输入或选择标签"
          bind:change="onTagsChange"
        />
      </view>
      <view class="info__actions">
        <view class="info__cancel" bindtap="onInfoToggle">取消</view>
        <view class="info__save" bindtap="onSaveInfo">{{savingInfo ? '保存中…' : '保存信息'}}</view>
      </view>
    </view>
  </view>
</view>
