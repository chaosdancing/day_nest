.viewer {
  width: 100vw;
  height: 100vh;
  background: #000;
  display: flex;
  align-items: center;
  justify-content: center;
}
.empty { color: #888; font-size: 26rpx; }
.swiper {
  width: 100%;
  height: 100%;
}
.slide {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}
.slide__img {
  width: 100%;
  height: 100%;
}
.slide__caption {
  position: absolute;
  bottom: 80rpx;
  left: 40rpx;
  right: 40rpx;
  text-align: center;
  font-size: 24rpx;
  color: #fff;
  background: rgba(0,0,0,.5);
  padding: 12rpx 20rpx;
  border-radius: 8rpx;
}
.counter {
  position: absolute;
  top: 40rpx;
  left: 50%;
  transform: translateX(-50%);
  color: #fff;
  font-size: 24rpx;
  background: rgba(0,0,0,.5);
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  z-index: 10;
}
