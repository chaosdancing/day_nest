.page {
  background: var(--paper-cream);
  min-height: 100vh;
}

.empty {
  padding: 80rpx 48rpx;
  text-align: center;
}
.empty__emoji {
  display: inline-block;
  font-size: 80rpx;
  line-height: 1;
}
.empty__title {
  margin-top: 16rpx;
  font-size: 56rpx;
  line-height: 1.1;
}
.empty__sub {
  margin-top: 24rpx;
  font-size: 26rpx;
  color: var(--ink-secondary);
  line-height: 1.6;
}

.scroll {
  padding: 16rpx 24rpx 200rpx;
}
.block {
  margin-bottom: 40rpx;
}
.block__title {
  margin-bottom: 16rpx;
  font-size: 22rpx;
  letter-spacing: 6rpx;
  color: var(--ink-secondary);
  text-transform: uppercase;
}
.cloud {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx 14rpx;
  padding: 8rpx 0;
}

.toolbar {
  display: flex;
  gap: 12rpx;
  margin-bottom: 24rpx;
}
.seg {
  padding: 10rpx 24rpx;
  border: 1px solid rgba(168, 138, 92, .35);
  border-radius: 999rpx;
  font-size: 24rpx;
  color: var(--ink-secondary);
  background: rgba(255, 252, 245, .7);
}
.seg--on {
  background: var(--ink-primary);
  color: var(--paper-cream);
  border-color: var(--ink-primary);
}
