<view class="page">
  <page-hero
    emoji="🏷️"
    title="标签"
    subtitle="TAGS · {{tags.length}} {{tags.length === 1 ? 'STICKER' : 'STICKERS'}}"
    motion="wobble"
  />

  <view wx:if="{{loading && tags.length === 0}}" class="empty">
    <text class="empty__emoji">🏷️</text>
    <view class="empty__title scribble">正在翻标签盒...</view>
  </view>
  <view wx:elif="{{!loading && tags.length === 0}}" class="empty">
    <text class="empty__emoji">📭</text>
    <view class="empty__title scribble">还没有标签</view>
    <view class="empty__sub">上传集合时给它贴上 #标签，回头从这里翻看。</view>
  </view>

  <scroll-view class="scroll" scroll-y="true">
    <view wx:if="{{popular.length > 0}}" class="block">
      <view class="block__title mono-label">POPULAR</view>
      <view class="cloud">
        <tape-chip
          wx:for="{{popular}}"
          wx:key="id"
          label="{{item.displayName}}"
          count="{{((item.photoCount || 0) + (item.collectionCount || 0)) + ''}}"
          tiltSeed="{{item.id}}"
          bind:tap="onTagTap"
          data-name="{{item.name}}"
          data-scope="{{(item.collectionCount || 0) === 0 && (item.photoCount || 0) > 0 ? 'photo' : 'all'}}"
        />
      </view>
    </view>

    <view class="toolbar">
      <view
        class="seg {{view === 'flat' ? 'seg--on' : ''}}"
        data-view="flat"
        bindtap="onSwitchView"
      >平铺</view>
      <view
        class="seg {{view === 'categorized' ? 'seg--on' : ''}}"
        data-view="categorized"
        bindtap="onSwitchView"
      >分类</view>
    </view>

    <view wx:if="{{view === 'flat'}}" class="block">
      <view class="cloud">
        <tape-chip
          wx:for="{{tags}}"
          wx:key="id"
          label="{{item.displayName}}"
          tiltSeed="{{item.id}}"
          bind:tap="onTagTap"
          data-name="{{item.name}}"
          data-scope="{{(item.collectionCount || 0) === 0 && (item.photoCount || 0) > 0 ? 'photo' : 'all'}}"
        />
      </view>
    </view>

    <block wx:if="{{view === 'categorized'}}">
      <view class="block">
        <view class="block__title mono-label">集合维度</view>
        <view class="cloud">
          <tape-chip
            wx:for="{{collectionTags}}"
            wx:key="id"
            label="{{item.displayName}}"
            count="{{(item.collectionCount || 0) + ''}}"
            tiltSeed="{{item.id}}"
            bind:tap="onTagTap"
            data-name="{{item.name}}"
            data-scope="collection"
          />
        </view>
      </view>
      <view class="block">
        <view class="block__title mono-label">照片维度</view>
        <view class="cloud">
          <tape-chip
            wx:for="{{photoOnlyTags}}"
            wx:key="id"
            label="{{item.displayName}}"
            count="{{(item.photoCount || 0) + ''}}"
            tiltSeed="{{item.id}}"
            bind:tap="onTagTap"
            data-name="{{item.name}}"
            data-scope="photo"
          />
        </view>
      </view>
    </block>
  </scroll-view>
</view>
