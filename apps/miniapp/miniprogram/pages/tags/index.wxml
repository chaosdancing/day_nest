<view class="page {{theme}} {{slide}}">
  <page-hero
    emoji="🏷️"
    title="标签"
    subtitle="TAGS · {{tags.length}} {{tags.length === 1 ? 'STICKER' : 'STICKERS'}}"
    motion="wobble"
  />

  <view wx:if="{{loading && tags.length === 0}}" class="empty">
    <text class="empty__emoji">🏷️</text>
    <view class="empty__title scribble">正在翻标签盒...</view>
  </view>
  <view wx:elif="{{!loading && tags.length === 0}}" class="empty">
    <text class="empty__emoji">📭</text>
    <view class="empty__title scribble">还没有标签</view>
    <view class="empty__sub">上传集合时给它贴上 #标签，回头从这里翻看。</view>
  </view>

  <scroll-view wx:else class="scroll" scroll-y="true">
    <view wx:if="{{popular.length > 0}}" class="section {{enterAnim ? 'section--enter' : ''}}">
      <view class="section__head">
        <text class="section__title">常用标签</text>
        <text class="section__meta">POPULAR</text>
      </view>
      <scroll-view class="hot-rail" scroll-x="true" enhanced="true" show-scrollbar="false">
        <view
          wx:for="{{popular}}"
          wx:key="id"
          class="hot-card"
          bind:tap="onTagTap"
          data-name="{{item.name}}"
          data-scope="{{(item.collectionCount || 0) === 0 && (item.photoCount || 0) > 0 ? 'photo' : 'all'}}"
        >
          <view class="hot-card__tag">
            <text class="hot-card__star">⭐</text>
            <text class="hot-card__rank">TOP {{index + 1}}</text>
          </view>
          <view class="hot-card__name"><text class="hot-card__hash">#</text>{{item.displayName}}</view>
          <view class="hot-card__count">
            <text class="hot-card__count-num">{{(item.photoCount || 0) + (item.collectionCount || 0)}}</text> 次收录
          </view>
        </view>
      </scroll-view>
    </view>

    <view wx:if="{{collectionTags.length > 0}}" class="section {{enterAnim ? 'section--enter' : ''}}">
      <view class="section__head">
        <text class="section__title">集合标签</text>
        <text class="section__meta">{{collectionTags.length}} TAGS</text>
      </view>
      <view class="tag-grid">
        <view
          wx:for="{{collectionTags}}"
          wx:key="id"
          class="tag-card"
          bind:tap="onTagTap"
          data-name="{{item.name}}"
          data-scope="collection"
        >
          <view class="tag-card__name"><text class="tag-card__hash">#</text>{{item.displayName}}</view>
          <view class="tag-card__count">
            <text class="tag-card__count-num">{{item.collectionCount || 0}}</text>
            <text class="tag-card__count-unit">个集合</text>
          </view>
        </view>
      </view>
    </view>

    <view wx:if="{{photoOnlyTags.length > 0}}" class="section {{enterAnim ? 'section--enter' : ''}}">
      <view class="section__head">
        <text class="section__title">照片标签</text>
        <text class="section__meta">{{photoOnlyTags.length}} TAGS</text>
      </view>
      <view class="tag-grid">
        <view
          wx:for="{{photoOnlyTags}}"
          wx:key="id"
          class="tag-card"
          bind:tap="onTagTap"
          data-name="{{item.name}}"
          data-scope="photo"
        >
          <view class="tag-card__name"><text class="tag-card__hash">#</text>{{item.displayName}}</view>
          <view class="tag-card__count">
            <text class="tag-card__count-num">{{item.photoCount || 0}}</text>
            <text class="tag-card__count-unit">张照片</text>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>
</view>
