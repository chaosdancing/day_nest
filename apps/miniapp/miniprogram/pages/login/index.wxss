.page {
  min-height: 100vh;
  padding: 160rpx 48rpx 80rpx;
  background: var(--paper-cream);
  display: flex;
  flex-direction: column;
  align-items: stretch;
}

.hero {
  text-align: center;
  margin-bottom: 120rpx;
}
.hero__brand {
  font-family: var(--font-mono);
  font-size: 22rpx;
  letter-spacing: 8rpx;
  color: var(--kraft-dark);
  opacity: .75;
}
.hero__title {
  display: block;
  font-size: 96rpx;
  line-height: 1.2;
  color: var(--ink-primary);
}
.hero__title + .hero__title {
  margin-top: 8rpx;
}

/* Hand-painted colour accent behind ONLY the "专属回忆" characters — a single
   rotated brush swash under the lower half of those four glyphs for a designed,
   warm pop without colouring the whole line. */
.hero__hl {
  position: relative;
  display: inline-block;
}
.hero__hl-fg {
  position: relative;
  z-index: 1;
}
.hero__hl-bg {
  position: absolute;
  left: -10rpx;
  right: -10rpx;
  bottom: 14rpx;
  height: 32rpx;
  z-index: 0;
  border-radius: 26rpx 30rpx 22rpx 34rpx;
  background: linear-gradient(
    100deg,
    var(--pin-yellow) 0%,
    var(--ink-sticker) 48%,
    var(--pin-red) 100%
  );
  opacity: .5;
  transform: rotate(-2deg) skewX(-6deg);
  /* A second, thinner highlight near the start gives it a brushed feel. */
  box-shadow: 0 -10rpx 0 -4rpx rgba(210, 176, 59, .35);
}

/* Login primary button. WeChat <button> ships with its own default
   width/padding/min-height that's a hair too narrow for our pill style,
   so we force width and add horizontal padding explicitly. */
.primary {
  width: 100%;
  background: var(--ink-primary);
  color: #FBF4E4;
  padding: 30rpx 48rpx;
  border-radius: 999rpx;
  font-size: 32rpx;
  letter-spacing: 4rpx;
  line-height: 1.4;
}
.primary[disabled] { opacity: .6; }

.secondary {
  margin-top: 48rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--ink-secondary);
  text-decoration: underline;
}
.secondary--dev {
  margin-top: 24rpx;
  color: var(--kraft-dark);
  font-size: 22rpx;
  opacity: .7;
}
.error {
  margin-top: 32rpx;
  font-size: 26rpx;
  color: var(--pin-red);
  text-align: center;
}
