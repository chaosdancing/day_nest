.page {
  min-height: 100vh;
  background: var(--paper-cream);
  padding: 24rpx 32rpx 200rpx;
}

.card {
  background: #FFFCF5;
  padding: 36rpx 32rpx;
  border-radius: 24rpx;
  box-shadow: var(--shadow-polaroid);
  margin-bottom: 28rpx;
}
/* Settle the settings cards in once the page mounts — first show only (via
   `card--enter`) so returning to the tab doesn't re-animate. */
.card--enter {
  opacity: 0;
  animation: me-card-in 260ms ease-out both;
}
@keyframes me-card-in {
  from { opacity: 0; transform: translateY(20rpx); }
  to   { opacity: 1; transform: translateY(0); }
}

/* Profile header — soft round avatar badge + name/@handle + edit affordance. */
.profile__top {
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.profile__avatar {
  flex-shrink: 0;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-hand);
  font-size: 56rpx;
  line-height: 1;
  color: var(--paper-cream);
  background: linear-gradient(135deg, var(--kraft-light), var(--kraft-dark));
  box-shadow: var(--shadow-sticker);
}
.profile__id {
  flex: 1;
  min-width: 0;
}
.profile__name {
  font-family: var(--font-hand);
  font-size: 44rpx;
  line-height: 1.2;
  color: var(--ink-primary);
  word-break: break-all;
}
.profile__handle {
  margin-top: 8rpx;
  font-family: var(--font-mono);
  font-size: 24rpx;
  color: var(--ink-secondary);
  opacity: .7;
  word-break: break-all;
}
.profile__edit {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 12rpx 22rpx;
  font-size: 24rpx;
  color: var(--ink-secondary);
  border-radius: 999rpx;
  background: rgba(168, 138, 92, .14);
  transition: transform 160ms ease, opacity 160ms ease;
}
.profile__edit:active {
  transform: scale(.94);
  opacity: .8;
}
.profile__edit-icon {
  font-size: 26rpx;
}
.profile__input {
  width: 100%;
  font-family: var(--font-hand);
  font-size: 40rpx;
  color: var(--ink-primary);
  background: var(--paper-cream);
  border-radius: 12rpx;
  padding: 14rpx 20rpx;
  line-height: 1.3;
  box-shadow: inset 0 0 0 2rpx rgba(168, 138, 92, .3);
}
.profile__placeholder {
  color: rgba(110, 95, 78, .45);
}

/* Save / cancel actions during inline edit */
.profile__actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 28rpx;
}
.btn {
  padding: 16rpx 40rpx;
  font-size: 28rpx;
  border-radius: 999rpx;
  transition: transform 160ms ease, opacity 160ms ease;
}
.btn:active {
  transform: scale(.96);
  opacity: .85;
}
.btn--ghost {
  color: var(--ink-secondary);
  background: rgba(168, 138, 92, .14);
}
.btn--solid {
  color: var(--paper-cream);
  background: var(--ink-primary);
}

.notice {
  margin-top: 24rpx;
  font-size: 24rpx;
  padding: 12rpx 20rpx;
  border-radius: 12rpx;
}
.notice--ok { color: #3b8e4f; background: rgba(123, 210, 158, .18); }
.notice--err { color: var(--pin-red); background: rgba(210, 59, 59, .12); }

/* Logout button — keep red but tonal */
.logout {
  width: 100%;
  background: var(--pin-red);
  color: #fff;
  padding: 30rpx 48rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
  line-height: 1.4;
  letter-spacing: 2rpx;
  transition: transform 160ms ease, opacity 160ms ease;
}
.logout:active {
  transform: scale(.98);
  opacity: .9;
}

.footer {
  text-align: center;
  margin-top: 32rpx;
  font-size: 22rpx;
  opacity: .55;
}
