.page {
  min-height: 100vh;
  background: var(--paper-cream);
  padding: 24rpx 24rpx 200rpx;
}

.card {
  background: #FFFCF5;
  padding: 28rpx 28rpx 24rpx;
  border-radius: 12rpx;
  box-shadow: var(--shadow-polaroid);
  margin-bottom: 24rpx;
}
.card__head {
  margin-bottom: 20rpx;
}

/* Generic key/value row */
.row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
  border-top: 1rpx dashed rgba(168, 138, 92, .22);
  min-height: 80rpx;
}
.row:first-child + .row,
.card .row:first-of-type {
  border-top: none;
}
.row__key {
  width: 120rpx;
  flex-shrink: 0;
}
.row__value {
  flex: 1;
  font-size: 32rpx;
  color: var(--ink-primary);
  line-height: 1.3;
  word-break: break-all;
}
.row__value--mono {
  font-family: var(--font-mono);
  font-size: 28rpx;
}
.row__hint {
  flex-shrink: 0;
  opacity: .55;
}
.row__input {
  flex: 1;
  font-size: 30rpx;
  color: var(--ink-primary);
  background: var(--paper-cream);
  border: 1px solid rgba(168, 138, 92, .35);
  border-radius: 6rpx;
  padding: 10rpx 16rpx;
  line-height: 1.4;
  height: 64rpx;
}
.row__placeholder {
  color: rgba(42, 37, 32, .35);
}
.row__action {
  flex-shrink: 0;
  padding: 6rpx 14rpx;
  font-size: 24rpx;
  color: var(--ink-secondary);
  border-radius: 999rpx;
  background: rgba(168, 138, 92, .15);
}
.row__action--save {
  background: var(--ink-primary);
  color: var(--paper-cream);
}
.row__action--cancel {
  background: rgba(168, 138, 92, .15);
}
.row__action-emoji {
  font-size: 26rpx;
}

.notice {
  margin-top: 12rpx;
  font-size: 22rpx;
  padding: 6rpx 12rpx;
  border-radius: 4rpx;
}
.notice--ok { color: #3b8e4f; background: rgba(123, 210, 158, .18); }
.notice--err { color: var(--pin-red); background: rgba(210, 59, 59, .12); }

/* Theme picker */
.theme {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}
.theme__opt {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding: 18rpx 12rpx;
  border-radius: 8rpx;
  background: rgba(255, 252, 245, .7);
  border: 1px solid rgba(168, 138, 92, .25);
  color: var(--ink-secondary);
  font-size: 22rpx;
}
.theme__opt--on {
  background: var(--ink-primary);
  border-color: var(--ink-primary);
  color: var(--paper-cream);
}
.theme__emoji { font-size: 32rpx; line-height: 1; }
.theme__label { font-size: 22rpx; }

/* Logout button — keep red but tonal */
.logout {
  width: 100%;
  background: var(--pin-red);
  color: #fff;
  padding: 30rpx 48rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
  line-height: 1.4;
  letter-spacing: 2rpx;
}

.footer {
  text-align: center;
  margin-top: 24rpx;
  opacity: .55;
}
