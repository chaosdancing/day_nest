<view class="page">
  <page-hero
    emoji="⚙️"
    title="设置"
    subtitle="SETTINGS"
    motion="wobble"
  />

  <!-- 账户 -->
  <view class="card">
    <view class="card__head mono-label">👤 账户</view>

    <view class="row">
      <view class="row__key mono-label">登录名</view>
      <view class="row__value row__value--mono">{{user.username || '—'}}</view>
      <view class="row__hint mono-label">不可改</view>
    </view>

    <view class="row">
      <view class="row__key mono-label">展示名</view>
      <block wx:if="{{!editing}}">
        <view class="row__value scribble" bindtap="onStartEditDisplay">
          {{user.displayName || '—'}}
        </view>
        <view class="row__action" bindtap="onStartEditDisplay">
          <text class="row__action-emoji">✏️</text>
        </view>
      </block>
      <block wx:else>
        <input
          class="row__input"
          value="{{draftDisplay}}"
          bindinput="onDraftInput"
          bindconfirm="onCommitDisplay"
          confirm-type="done"
          maxlength="64"
          focus="{{true}}"
          placeholder-class="row__placeholder"
        />
        <view class="row__action row__action--cancel" bindtap="onCancelEditDisplay">取消</view>
        <view class="row__action row__action--save" bindtap="onCommitDisplay">
          {{saving ? '保存中…' : '保存'}}
        </view>
      </block>
    </view>

    <view wx:if="{{notice}}" class="notice notice--{{noticeKind}}">{{notice}}</view>
  </view>

  <!-- 外观 -->
  <view class="card">
    <view class="card__head mono-label">🎨 外观</view>
    <view class="theme">
      <view
        wx:for="{{themeOptions}}"
        wx:key="key"
        class="theme__opt {{themeMode === item.key ? 'theme__opt--on' : ''}}"
        data-mode="{{item.key}}"
        bindtap="onPickTheme"
      >
        <text class="theme__emoji">{{item.emoji}}</text>
        <text class="theme__label">{{item.label}}</text>
      </view>
    </view>
  </view>

  <!-- 退出 -->
  <view class="card">
    <button class="logout" bindtap="onLogout">退出登录</button>
  </view>

  <view class="footer mono-label">慢慢记 · v0.1 · MINIAPP</view>
</view>
