<view class="page {{theme}} {{slide}}">
  <page-hero
    emoji="⚙️"
    title="设置"
    subtitle="SETTINGS"
    motion="wobble"
  />

  <!-- 账户 / 个人资料 -->
  <view class="card profile {{enterAnim ? 'card--enter' : ''}}">
    <view class="profile__top">
      <view class="profile__avatar">{{user.displayName ? user.displayName[0] : '🌱'}}</view>

      <block wx:if="{{!editing}}">
        <view class="profile__id">
          <view class="profile__name">{{user.displayName || '未命名'}}</view>
          <view class="profile__handle">@{{user.username || '—'}}</view>
        </view>
        <view class="profile__edit" bindtap="onStartEditDisplay">
          <text class="profile__edit-icon">✏️</text>
          <text>编辑</text>
        </view>
      </block>

      <view wx:else class="profile__id">
        <input
          class="profile__input"
          value="{{draftDisplay}}"
          bindinput="onDraftInput"
          bindconfirm="onCommitDisplay"
          confirm-type="done"
          maxlength="64"
          focus="{{true}}"
          placeholder="起个温暖的名字"
          placeholder-class="profile__placeholder"
        />
        <view class="profile__handle">@{{user.username || '—'}}</view>
      </view>
    </view>

    <view wx:if="{{editing}}" class="profile__actions">
      <view class="btn btn--ghost" bindtap="onCancelEditDisplay">取消</view>
      <view class="btn btn--solid" bindtap="onCommitDisplay">
        {{saving ? '保存中…' : '保存'}}
      </view>
    </view>

    <view wx:if="{{notice}}" class="notice notice--{{noticeKind}}">{{notice}}</view>
  </view>

  <!-- 邀请家人 — 仅对有上传权限的家人开放 -->
  <view wx:if="{{user.canUpload}}" class="card invite {{enterAnim ? 'card--enter' : ''}}">
    <view class="invite__head">
      <text class="invite__emoji">💌</text>
      <view class="invite__title">邀请家人</view>
    </view>
    <view class="invite__sub">生成一个邀请，发给家人即可加入、一起发照片。</view>

    <view wx:if="{{!inviteToken}}" class="invite__gen">
      <view class="btn btn--solid invite__gen-btn" bindtap="onGenerateInvite">
        {{inviteBusy ? '生成中…' : '✨ 生成邀请'}}
      </view>
    </view>

    <block wx:else>
      <view class="invite__field">
        <text class="invite__label">邀请码</text>
        <view class="invite__value mono-label">{{inviteToken}}</view>
        <view class="invite__copy" bindtap="onCopyInviteCode">复制</view>
      </view>
      <view class="invite__field">
        <text class="invite__label">邀请链接</text>
        <view class="invite__value invite__value--link">{{inviteLink}}</view>
        <view class="invite__copy" bindtap="onCopyInviteLink">复制</view>
      </view>
      <view class="invite__meta">有效期至 {{inviteExpiresLabel}} · 仅可使用一次</view>
      <view class="invite__again" bindtap="onGenerateInvite">
        {{inviteBusy ? '生成中…' : '重新生成'}}
      </view>
    </block>
  </view>

  <!-- 退出 -->
  <view class="card {{enterAnim ? 'card--enter' : ''}}">
    <button class="logout" bindtap="onLogout">退出登录</button>
  </view>

  <view class="footer mono-label">慢慢记 · v0.1 · MINIAPP</view>
</view>
