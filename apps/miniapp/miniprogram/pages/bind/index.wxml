<view class="page {{theme}}">
  <view class="head">
    <text class="head__emoji">🪄</text>
    <view class="head__title scribble">创建你的慢慢记</view>
    <view class="head__sub mono-label">WELCOME</view>
  </view>

  <view class="hint">
    用当前微信创建一个新账号即可开始浏览。想发照片？填入家人的邀请码就行。
  </view>

  <view class="field">
    <view class="label mono-label">展示名（家人看到的名字）</view>
    <input
      class="input"
      type="nickname"
      placeholder-class="input-placeholder"
      placeholder="点这里填入微信昵称，可修改"
      value="{{displayName}}"
      bindinput="onDisplayName"
      bindblur="onDisplayName"
    />
  </view>

  <view class="field">
    <view class="label mono-label">登录名（可修改）</view>
    <input
      class="input"
      placeholder-class="input-placeholder"
      placeholder="3-32位字母数字下划线"
      value="{{username}}"
      bindinput="onUsername"
    />
  </view>

  <view class="field">
    <view class="label-row">
      <view class="label mono-label">邀请码</view>
      <view class="mode mode--opt">选填 · 发照片才需要</view>
    </view>
    <input
      class="input"
      placeholder-class="input-placeholder"
      placeholder="留空仅浏览；粘贴邀请码即可发照片"
      value="{{inviteToken}}"
      bindinput="onInviteToken"
    />
  </view>

  <button class="primary" disabled="{{!canSubmit || loading}}" bindtap="onSubmit">
    {{loading ? '进入中...' : (inviteToken ? '注册并进入（可发照片）' : '注册并进入（先逛逛）')}}
  </button>

  <view wx:if="{{error}}" class="error">{{error}}</view>
</view>
