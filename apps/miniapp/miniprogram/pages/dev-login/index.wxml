<view class="page {{theme}}">
  <view class="head">
    <text class="head__emoji">🛠️</text>
    <view class="head__title scribble">开发登录</view>
    <view class="head__sub mono-label">DEV-ONLY ENTRY</view>
  </view>

  <view class="hint">绕过微信，用用户名 + 密码直接登录。仅在 DevTools / 体验版可用。</view>
  <view class="hint-sub">提示：access token 过期（约 15 分钟）后需要重新开发登录。</view>

  <view class="field">
    <view class="label mono-label">用户名</view>
    <input
      class="input"
      placeholder-class="input-placeholder"
      placeholder="如 admin / mom"
      value="{{username}}"
      bindinput="onUsername"
    />
  </view>

  <view class="field">
    <view class="label mono-label">密码</view>
    <input
      class="input"
      placeholder-class="input-placeholder"
      password="{{true}}"
      placeholder="账号密码"
      value="{{password}}"
      bindinput="onPassword"
    />
  </view>

  <button class="primary" disabled="{{!canSubmit || loading}}" bindtap="onSubmit">
    {{loading ? '登录中...' : '直接登录'}}
  </button>

  <view wx:if="{{error}}" class="error">{{error}}</view>
</view>
