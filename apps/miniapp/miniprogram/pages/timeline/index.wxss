.page {
  background: var(--paper-cream);
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

/* ──────────────── Compact collapsible control bar ────────────────
   Collapsed by default: a slim row with a search affordance + a 筛选 toggle,
   plus a derived summary of any active filters. Tapping expands an inline
   panel (animated max-height/opacity) with the search input + filter chips. */
.controls {
  position: sticky;
  top: 0;
  z-index: 10;
  margin: 0 24rpx 12rpx;
  padding: 12rpx;
  border-radius: 22rpx;
  background: rgba(243, 230, 203, .9);
  box-shadow: 0 6rpx 18rpx rgba(42, 37, 32, .08);
  backdrop-filter: blur(8rpx);
}

.controls__bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
/* Always-visible inline title search — type directly in the bar (no separate
   dropdown input). The 筛选 toggle next to it reveals date/location filters. */
.controls__search {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
  min-height: 64rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 252, 245, .72);
  box-shadow: inset 0 0 0 1px rgba(168, 138, 92, .12);
  transition: background-color 160ms ease, box-shadow 160ms ease;
}
.controls__search--filled {
  background: rgba(168, 138, 92, .15);
  box-shadow: inset 0 0 0 1px rgba(168, 138, 92, .45);
}
.controls__search-icon {
  font-size: 28rpx;
  color: var(--kraft-dark);
  flex-shrink: 0;
}
.controls__search-input {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  line-height: 1.3;
  color: var(--ink-primary);
  background: transparent;
}
.controls__search-placeholder {
  color: rgba(42, 37, 32, .35);
}
.controls__search-clear {
  flex-shrink: 0;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: rgba(168, 138, 92, .25);
  color: rgba(42, 37, 32, .65);
  text-align: center;
  line-height: 36rpx;
  font-size: 24rpx;
}
.controls__toggle {
  display: flex;
  align-items: center;
  gap: 6rpx;
  flex-shrink: 0;
  min-height: 64rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: rgba(255, 252, 245, .72);
  color: var(--ink-primary);
  transition: background-color 160ms ease, color 160ms ease, transform 160ms ease;
}
.controls__toggle:active {
  transform: scale(.96);
}
/* Kraft-filled pill when filters are active so the user sees they're applied. */
.controls__toggle--active {
  background: var(--kraft-base);
  color: #FBF4E4;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, .08);
}
.controls__toggle-label {
  font-size: 26rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}
.controls__caret {
  font-size: 22rpx;
  line-height: 1;
  transition: transform 240ms cubic-bezier(.22, 1, .36, 1);
}
.controls--open .controls__caret {
  transform: rotate(180deg);
}

/* Collapsed summary — tiny chips that prove filters are applied at a glance. */
.controls__summary {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  padding: 12rpx 6rpx 4rpx;
}
.sumchip {
  font-size: 22rpx;
  line-height: 1.2;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(168, 138, 92, .16);
  color: var(--ink-secondary);
  white-space: nowrap;
}

/* Expandable panel — animate height + fade so it feels summoned, not jarring. */
.controls__panel {
  max-height: 0;
  opacity: 0;
  overflow: hidden;
  transition: max-height 300ms cubic-bezier(.22, 1, .36, 1), opacity 220ms ease;
}
.controls--open .controls__panel {
  max-height: 900rpx;
  opacity: 1;
}
.controls__panel-inner {
  padding-top: 16rpx;
}

/* ──────────────── Empty state ──────────────── */
.empty {
  padding: 120rpx 48rpx;
  text-align: center;
}
.empty__emoji {
  display: inline-block;
  font-size: 80rpx;
  line-height: 1;
  animation: empty-wobble 4s ease-in-out infinite;
}
.empty__title {
  margin-top: 16rpx;
  font-size: 56rpx;
  line-height: 1.1;
}
.empty__sub {
  margin-top: 24rpx;
  font-size: 26rpx;
  color: var(--ink-secondary);
  line-height: 1.6;
}
@keyframes empty-wobble {
  0%, 100% { transform: rotate(-8deg); }
  50%      { transform: rotate(8deg); }
}

/* ──────────────── Timeline rows ──────────────── */
.list {
  flex: 1;
  width: 100%;
  box-sizing: border-box;
  /* Slightly larger right padding plus a small left shift on the polaroid
     keeps stacked cards visually attached to the rail without making the
     collection cover feel undersized. */
  padding: 16rpx 68rpx 200rpx 60rpx;
  position: relative;
  overflow-x: hidden;
}
/* Left rail behind the dots */
.list::before {
  content: '';
  position: absolute;
  top: 0;
  bottom: 0;
  left: 40rpx;
  width: 2rpx;
  background: repeating-linear-gradient(
    180deg,
    rgba(168, 138, 92, .6) 0 12rpx,
    transparent 12rpx 22rpx
  );
  background-size: 2rpx 44rpx;
  transition: opacity 160ms ease;
}
.list--scrolling::before {
  animation: timeline-rail-flow 520ms linear infinite;
  opacity: .95;
}

.row {
  position: relative;
  padding: 16rpx 0 32rpx;
}
/* Entrance stagger — applied (via `row--enter`) only on the first load so
   returning to the tab shows rows immediately without re-animating. */
.row--enter {
  opacity: 0;
  animation: timeline-row-in 420ms ease-out both;
}
.row__dot {
  position: absolute;
  left: -36rpx;
  top: 12rpx;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: var(--ink-sticker);
  border: 4rpx solid var(--paper-cream);
  box-shadow: 0 0 0 6rpx rgba(212, 82, 58, .15);
  transition: transform 160ms ease, box-shadow 160ms ease;
}
.list--scrolling .row__dot {
  animation: timeline-dot-pulse 900ms ease-in-out infinite;
}

.row__meta {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  /* Generous bottom margin so the rotated polaroid (≈±2°) corner + drop
     shadow don't bleed up into the date line above. */
  margin-bottom: 28rpx;
}
.row__date {
  font-family: var(--font-mono);
  font-size: 26rpx;
  letter-spacing: 3rpx;
  color: var(--ink-secondary);
  text-transform: uppercase;
}
.row__loc {
  font-size: 26rpx;
  color: var(--ink-secondary);
  line-height: 1.3;
}

.row__card {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  transition: opacity 160ms ease;
}
/* Press feedback for the tappable row (opens the collection detail). */
.row:active .row__card {
  opacity: .8;
}
/* Cap the polaroid card width so the timeline rows feel album-sized
   instead of edge-to-edge. ~530rpx is roughly the same proportion as
   the web timeline's polaroid relative to a phone-width viewport. */
.row__polaroid {
  width: 100%;
  max-width: 530rpx;
  margin: 0 auto;
  transform: translateX(-18rpx);
}
/* Caption is rendered INSIDE the polaroid (stacked-polaroid passes through
   the `caption` prop), matching apps/web/src/components/scrapbook/Polaroid.tsx.
   The row keeps tags directly under the frame, no big handwritten title gap. */
.row__tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  padding: 0 8rpx;
  transform: translateX(-14rpx);
}

.footer {
  padding: 32rpx 0;
  text-align: center;
  color: var(--ink-secondary);
  font-size: 26rpx;
}

/* ──────────────── FAB ──────────────── */
.fab {
  position: fixed;
  right: 40rpx;
  /* Keep the upload action clearly above the floating tab bar instead of
     visually touching it near the home indicator. */
  bottom: calc(env(safe-area-inset-bottom) + 214rpx);
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--ink-primary);
  color: var(--paper-cream);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,.22);
  z-index: 5;
}
.fab__plus {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 58rpx;
  line-height: 96rpx;
  color: var(--paper-cream);
  transform: translateY(-2rpx);
}

@keyframes timeline-row-in {
  from {
    opacity: 0;
    transform: translateY(34rpx) rotate(-1deg);
  }
  to {
    opacity: 1;
    transform: translateY(0) rotate(0);
  }
}

@keyframes timeline-rail-flow {
  from { background-position-y: 0; }
  to   { background-position-y: 44rpx; }
}

@keyframes timeline-dot-pulse {
  0%, 100% {
    transform: scale(1);
    box-shadow: 0 0 0 6rpx rgba(212, 82, 58, .15);
  }
  50% {
    transform: scale(1.16);
    box-shadow: 0 0 0 12rpx rgba(212, 82, 58, .08);
  }
}
