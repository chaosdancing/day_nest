<view class="page {{theme}} {{slide}}">
  <page-hero
    emoji="📖"
    title="时光轴"
    subtitle="TIMELINE · {{items.length}} ENTRIES"
    motion="wobble"
  />

  <view class="controls {{filtersOpen ? 'controls--open' : ''}}">
    <view class="controls__bar">
      <view class="controls__search {{searchInput ? 'controls__search--filled' : ''}}">
        <text class="controls__search-icon">🔎</text>
        <input
          class="controls__search-input"
          placeholder="搜索集合名 (周末 / 生日 …)"
          placeholder-class="controls__search-placeholder"
          value="{{searchInput}}"
          confirm-type="search"
          bindfocus="onSearchFocus"
          bindinput="onSearchInput"
          bindconfirm="onSearchConfirm"
        />
        <view wx:if="{{searchInput}}" class="controls__search-clear" catchtap="onSearchClear">×</view>
      </view>
      <view
        class="controls__toggle {{hasActiveFilters ? 'controls__toggle--active' : ''}}"
        bindtap="onToggleFilters"
      >
        <text class="controls__toggle-label">筛选</text>
        <text class="controls__caret">▾</text>
      </view>
    </view>

    <view wx:if="{{(summaryDate || filter.location) && !filtersOpen}}" class="controls__summary">
      <view wx:if="{{summaryDate}}" class="sumchip">📅 {{summaryDate}}</view>
      <view wx:if="{{filter.location}}" class="sumchip">📍 {{filter.location}}</view>
    </view>

    <view class="controls__panel">
      <view class="controls__panel-inner">
        <timeline-filters bind:change="onFilterChange" />
      </view>
    </view>
  </view>

  <view wx:if="{{loading && items.length === 0}}" class="empty">
    <text class="empty__emoji">📖</text>
    <view class="empty__title scribble">正在翻开相册...</view>
  </view>
  <view wx:elif="{{!loading && items.length === 0}}" class="empty">
    <text class="empty__emoji">📭</text>
    <view class="empty__title scribble">空相册</view>
    <view class="empty__sub">还没有任何回忆，点右下角 + 上传第一个集合 📸</view>
  </view>

  <scroll-view
    class="list {{isScrolling ? 'list--scrolling' : ''}}"
    scroll-y="true"
    enable-back-to-top="true"
    enhanced="{{true}}"
    bindscroll="onListScroll"
    bindscrolltolower="onLoadMore"
  >
    <view
      wx:for="{{items}}"
      wx:key="id"
      class="row {{enterAnim ? 'row--enter' : ''}}"
      style="animation-delay: {{enterAnim ? index * 60 : 0}}ms;"
      data-id="{{item.id}}"
      bindtap="onCardTap"
    >
      <view class="row__dot"></view>

      <view class="row__meta">
        <text class="row__date">{{item.displayDate}}</text>
        <text wx:if="{{item.location}}" class="row__loc serif">· {{item.location}}</text>
      </view>

      <view class="row__card">
        <view class="row__polaroid">
          <stacked-polaroid
            previewPhotos="{{item.previewPhotos}}"
            photoCount="{{item.photoCount}}"
            caption="{{item.title}}"
          />
        </view>

        <view wx:if="{{item.tags.length}}" class="row__tags">
          <tape-chip
            wx:for="{{item.tags}}"
            wx:for-item="tag"
            wx:key="id"
            label="{{tag.displayName}}"
            tiltSeed="{{item.id}}-{{tag.id}}"
          />
        </view>
      </view>
    </view>

    <view wx:if="{{loadingMore}}" class="footer">正在翻下一页...</view>
    <view wx:elif="{{!nextCursor && items.length > 0}}" class="footer">到底了</view>
  </scroll-view>

  <view class="fab" bindtap="onFabTap">
    <text class="fab__plus">+</text>
  </view>
</view>
