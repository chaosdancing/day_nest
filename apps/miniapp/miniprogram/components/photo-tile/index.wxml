<view class="tile polaroid" style="transform: rotate({{angle}}deg);" bindtap="onTap">
  <view class="tape tape--{{tape}}"></view>
  <view
    class="polaroid__photo-frame"
    style="{{frameStyle}}"
  >
    <image class="polaroid__photo" src="{{thumbnailUrl}}" mode="aspectFill" lazy-load="true"></image>
  </view>
  <view wx:if="{{caption}}" class="polaroid__caption">{{caption}}</view>
  <view wx:if="{{subtitle}}" class="tile__subtitle mono-label">{{subtitle}}</view>
  <view
    wx:if="{{showHeart}}"
    class="tile__heart {{favoritedByMe ? 'tile__heart--on' : ''}}"
    catchtap="onFavoriteTap"
  >
    <text class="tile__heart-glyph">{{favoritedByMe ? '♥' : '♡'}}</text>
    <text wx:if="{{favoriteCount > 0}}" class="tile__heart-count">{{favoriteCount}}</text>
  </view>
</view>
