/* Timeline filter bar. Visual reference: apps/web/src/pages/TimelinePage.tsx
   (sticky filter rail with emoji chips + tinted-when-filled inputs). */

.filters {
  position: sticky;
  top: 0;
  z-index: 10;
  margin: 0 24rpx 16rpx;
  padding: 22rpx 18rpx;
  border-radius: 12rpx;
  border: 1px solid rgba(168, 138, 92, .25);
  background: rgba(243, 230, 203, .82);
  backdrop-filter: blur(6rpx);
  box-shadow: 0 1px 2px rgba(0,0,0,.05);
}

.filters__chips {
  white-space: nowrap;
  display: flex;
  gap: 14rpx;
}

.chip {
  display: inline-flex;
  align-items: stretch;
  flex-shrink: 0;
  margin-right: 12rpx;
}

.chip__btn {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  min-height: 56rpx;
  padding: 10rpx 24rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  border: 1px solid rgba(168, 138, 92, .35);
  background: rgba(255, 252, 245, .7);
  color: rgba(42, 37, 32, .7);
  font-size: 24rpx;
  line-height: 1.2;
  transition: background-color 160ms ease, color 160ms ease;
}

.chip__btn--has-clear {
  border-top-right-radius: 0;
  border-bottom-right-radius: 0;
  border-right: none;
}

.chip--on .chip__btn {
  background: var(--kraft-base);
  color: #FBF4E4;
  border-color: var(--kraft-base);
  box-shadow: 0 1px 2px rgba(0,0,0,.08);
}

.chip__emoji {
  font-size: 26rpx;
  line-height: 1;
}
.chip__label {
  font-size: 26rpx;
}

.chip__clear {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 44rpx;
  padding: 0 12rpx 0 6rpx;
  border-radius: 0 999rpx 999rpx 0;
  background: var(--kraft-base);
  color: rgba(251, 244, 228, .8);
  font-size: 28rpx;
  line-height: 1;
}

/* Custom range row */
.filters__custom {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1px dashed rgba(168, 138, 92, .35);
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}
.filters__custom-label {
  font-family: var(--font-mono);
  font-size: 20rpx;
  letter-spacing: 4rpx;
  color: rgba(42, 37, 32, .45);
}
.filters__date {
  font-family: var(--font-mono);
  font-size: 24rpx;
  padding: 8rpx 16rpx;
  border-radius: 6rpx;
  border: 1px solid rgba(168, 138, 92, .35);
  background: rgba(255, 252, 245, .85);
  color: var(--ink-primary);
}
.filters__dash {
  color: rgba(42, 37, 32, .35);
}

/* Location search row — tints when filled */
.filters__search {
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-height: 64rpx;
  padding: 12rpx 20rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  border: 1px solid rgba(168, 138, 92, .25);
  background: rgba(255, 252, 245, .7);
  transition: background-color 160ms ease, border-color 160ms ease;
}
.filters__search--filled {
  background: rgba(168, 138, 92, .15);
  border-color: rgba(168, 138, 92, .55);
}
.filters__search-icon {
  font-size: 26rpx;
  color: var(--kraft-dark);
}
.filters__search-input {
  flex: 1;
  font-size: 28rpx;
  line-height: 1.3;
  color: var(--ink-primary);
  background: transparent;
}
.filters__search-placeholder {
  color: rgba(42, 37, 32, .35);
}
.filters__search-clear {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: rgba(168, 138, 92, .25);
  color: rgba(42, 37, 32, .65);
  text-align: center;
  line-height: 36rpx;
  font-size: 24rpx;
}
