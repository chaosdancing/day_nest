.bar {
  position: fixed;
  left: 28rpx;
  right: 28rpx;
  bottom: calc(env(safe-area-inset-bottom) + 18rpx);
  height: 104rpx;
  padding: 10rpx 12rpx;
  box-sizing: border-box;
  background: rgba(255, 252, 245, .92);
  border: 1px solid rgba(168, 138, 92, .22);
  border-radius: 999rpx;
  box-shadow: 0 12rpx 34rpx rgba(42, 37, 32, .18);
  backdrop-filter: blur(10rpx);
  display: flex;
  gap: 6rpx;
  z-index: 100;
}
.item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
  min-width: 0;
  border-radius: 999rpx;
  color: var(--ink-secondary);
  transition: background-color 160ms ease, color 160ms ease, transform 160ms ease;
}
.item--active {
  color: var(--ink-primary);
  background: rgba(168, 138, 92, .16);
  transform: translateY(-2rpx);
}
.icon {
  height: 34rpx;
  line-height: 34rpx;
  font-size: 26rpx;
  color: currentColor;
  opacity: .72;
}
.item--active .icon {
  opacity: 1;
  color: var(--ink-sticker);
}
.label {
  font-size: 20rpx;
  line-height: 1.2;
  font-weight: 600;
  color: currentColor;
  white-space: nowrap;
}
