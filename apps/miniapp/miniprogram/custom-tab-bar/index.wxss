.bar {
  position: fixed;
  left: 28rpx;
  right: 28rpx;
  bottom: calc(env(safe-area-inset-bottom) + 18rpx);
  height: 104rpx;
  padding: 10rpx 12rpx;
  box-sizing: border-box;
  background: rgba(255, 252, 245, .92);
  border: 1px solid rgba(168, 138, 92, .22);
  border-radius: 999rpx;
  box-shadow: 0 12rpx 34rpx rgba(42, 37, 32, .18);
  backdrop-filter: blur(10rpx);
  display: flex;
  gap: 6rpx;
  z-index: 100;
}
.item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
  min-width: 0;
  border-radius: 999rpx;
  color: var(--ink-secondary);
  transition: background-color 180ms ease, color 180ms ease,
    transform 180ms cubic-bezier(.34, 1.56, .64, 1), opacity 180ms ease;
}
/* Tactile press feedback — gently sinks + dims while the finger is down. */
.item:active {
  transform: scale(.92);
  opacity: .7;
}
.item--active {
  color: var(--ink-primary);
  background: rgba(168, 138, 92, .16);
  transform: translateY(-2rpx);
}
/* Keep the active tab's lifted look even mid-press (slight sink, no shrink). */
.item--active:active {
  transform: translateY(-1rpx) scale(.96);
  opacity: .85;
}
.icon {
  height: 40rpx;
  line-height: 40rpx;
  font-size: 32rpx;
  color: currentColor;
  opacity: .72;
}
.item--active .icon {
  opacity: 1;
  color: var(--ink-sticker);
}
.label {
  font-size: 24rpx;
  line-height: 1.2;
  font-weight: 600;
  color: currentColor;
  white-space: nowrap;
}
