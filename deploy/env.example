# DayNest production environment
# Copy to /etc/daynest/.env and `chmod 600`. NEVER commit real values.

# ----- runtime -----
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# ----- database (absolute path so pm2/systemd find it consistently) -----
DATABASE_URL=file:/var/lib/daynest/daynest.db

# ----- JWT secrets (>= 32 chars; generate with: openssl rand -base64 48) -----
JWT_SECRET=replace-me-with-a-real-secret-at-least-32-chars
JWT_REFRESH_SECRET=replace-me-with-a-separate-refresh-secret-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
INVITE_TOKEN_TTL_HOURS=72

# ----- Qiniu Kodo -----
QINIU_ACCESS_KEY=your-qiniu-access-key
QINIU_SECRET_KEY=your-qiniu-secret-key
QINIU_BUCKET=daynest-prod
# Domain bound to the bucket; use HTTPS, custom domain preferred
QINIU_DOMAIN=https://cdn.example.com
# Zone: z0=华东, z1=华北, z2=华南, na0=北美, as0=东南亚
QINIU_ZONE=z0

# ----- CORS / Cookies -----
# Single origin recommended for private deployment
CORS_ORIGIN=https://daynest.example.com
# Set this so refresh cookie sticks across subdomains if relevant
# COOKIE_DOMAIN=.example.com

# ----- Backup (consumed by deploy/scripts/backup-sqlite.sh) -----
BACKUP_QINIU_BUCKET=daynest-backups
BACKUP_QINIU_KEY_PREFIX=sqlite/
